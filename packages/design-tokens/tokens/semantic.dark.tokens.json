    "$type": "dimension",
    "$value": {
      "value": 14,
      "unit": "%"
    },
    "$description": "Dark half of the hairline alpha (D14): near-white ink needs more alpha than near-black to read as a line — foreground at 14% over card measures L 0.325, over the page 0.302."
  },
