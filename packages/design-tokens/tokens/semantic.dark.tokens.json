  },
  "secondary-foreground": {
    "$type": "color",
    "$value": "{foreground}"
  },
  "muted": {
    "$type": "color",
    "$value": "{surface-1}"
  },
  "muted-foreground": {
    "$type": "color",
    "$value": "{color.neutral.450}"
