  },
  "sidebar-width": {
    "$type": "dimension",
    "$value": {
      "value": 15,
      "unit": "rem"
    },
    "$description": "Expanded sidebar rail width (was a JS constant invisible to design-lint, register P2-13)."
  },
  "sidebar-width-icon": {
    "$type": "dimension",
    "$value": {
      "value": 3,
      "unit": "rem"
    },
    "$description": "Collapsed icon-only rail width."
  },
  "shadow-overlay": {
    "$type": "shadow",
    "$value": "0 4px 14px -4px oklch(0.13 0.002 75 / 0.10), 0 2px 4px -2px oklch(0.13 0.002 75 / 0.06)"
  },
  "shadow-lit": {
    "$type": "shadow",
    "$value": "inset 0 1px 0 0 oklch(1 0 0 / 0.12), 0 1px 2px 0 oklch(0.13 0.002 75 / 0.18), 0 2px 6px -2px oklch(0.13 0.002 75 / 0.14)",
    "$description": "Wave 2 'lit' action finish (MK-approved amendment to flat-by-default): a 1px on-fill top-light + warm-ink ambient pair for PRIMARY actions only. Attio-calibrated, warm-adapted. Never on cards/surfaces \u2014 the flat elevation model stands everywhere else."
  },
  "effect-blur-glass": {
    "$type": "dimension",
    "$value": {
      "value": 8,
      "unit": "px"
    },
    "$description": "Backdrop blur for the existing glass Button finish. Matches Tailwind v4's shipped blur-sm value while exposing the effect through a semantic contract."
  },
  "z-raised": {
    "$type": "number",
    "$value": 10,
    "$description": "Local raise WITHIN a component's own stacking context (focused OTP slot / segmented item, floating label, bubble reactions, select scroll arrows). Never for portaled surfaces."
  },
  "z-overlay": {
    "$type": "number",
    "$value": 50,
    "$description": "The single portal band: every portaled floating surface (dialog, sheet, popover, menu, select, tooltip, hover-card). Nesting resolves by DOM order \u2014 Base UI appends portals to <body>, so a Select inside a Dialog mounts later and stacks above within the same band. Toasts (sonner) are the documented exemption ABOVE this band (library-managed z; a toast must outrank a modal regardless of mount order)."
  },
  "opacity-dim": {
    "$type": "dimension",
    "$value": {
      "value": 50,
      "unit": "%"
    },
    "$description": "Element opacity for disabled controls and dimmed affordances (outside-month days, decorative chevrons)."
  },
  "opacity-hint-soft": {
    "$type": "dimension",
    "$value": {
      "value": 60,
