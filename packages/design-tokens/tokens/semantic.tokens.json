  "brand": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [0.6, 0.17, 148],
      "alpha": 1
    },
    "$description": "The phosphor-green brand accent, LIGHT half (theme-split per CX-9): marker roles ONLY (live/AI-state dot, sparkline endpoint, eyebrow highlight, terminal prompt glyph). 3.5:1 on card/background \u2014 meaningful glyphs pass WCAG 1.4.11. Never fills, borders-at-rest, headlines, or buttons."
  },
  "tag-blue": {
    "$type": "color",
    "$value": {
      "colorSpace": "oklch",
      "components": [0.6, 0.16, 256],
      "alpha": 1
    },
    "$description": "Tag palette (Attio-teardown Wave 1): 10 chromatic hues x base/subtle/text mirroring the family/family-subtle/family-text shape. base = dots/accents (>=3:1 non-text vs background), subtle = chip fill, text = chip text (>=4.5:1 on subtle AND page). Neutral tags use muted/muted-foreground. AA-validated fail-closed in contrast-check.mjs."
  },
