{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "shadcn base-nova's `neutral` colour base, verbatim except where a decision in docs/plans/2026-09-18-shadcn-reset/decisions.md says otherwise. Achromatic (chroma 0) in both themes — the warm hue-75 ramp the pre-reset system used is gone (COL-1 = shadcn).",
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, 0],
        "alpha": 1
      }
    },
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0, 0, 0],
        "alpha": 1
      }
    },
    "neutral": {
      "50": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.985, 0, 0],
          "alpha": 1
        }
      },
      "100": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0, 0],
          "alpha": 1
        }
      },
      "200": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.922, 0, 0],
          "alpha": 1
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.708, 0, 0],
          "alpha": 1
        }
      },
      "500": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.539, 0, 0],
          "alpha": 1
        },
        "$description": "Secondary text ink. shadcn ships 0.556, which measures 4.34:1 on `muted` (0.97) — below the AA floor A11Y-1 gates. 0.539 measures 4.66:1 there and 5.08:1 on the page. The extra headroom over the 4.5 threshold is deliberate: axe measures the 8-bit sRGB round-trip (#717171 on #f5f5f5), which reads ~0.04 lower than the OKLCH computation, so a token that clears 4.51 in the token gate still fails the rendered lane. This is the one core-neutral deviation from upstream."
      },
      "800": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.269, 0, 0],
          "alpha": 1
        }
      },
      "900": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.205, 0, 0],
          "alpha": 1
        }
      },
      "950": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.145, 0, 0],
          "alpha": 1
        }
      }
    },
    "white-alpha": {
      "10": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "alpha": 0.1
        }
      },
      "15": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "alpha": 0.15
        }
      }
    }
  }
}
