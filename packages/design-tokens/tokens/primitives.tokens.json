{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "shadcn base-nova's `neutral` colour base, verbatim except where a decision in docs/plans/2026-09-18-shadcn-reset/decisions.md says otherwise. Achromatic (chroma 0) in both themes — the warm hue-75 ramp the pre-reset system used is gone (COL-1 = shadcn).",
    "white": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, 0],
        "alpha": 1
      }
    },
    "black": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0, 0, 0],
        "alpha": 1
      }
    },
    "neutral": {
      "50": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.985, 0, 0],
          "alpha": 1
        }
      },
      "100": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0, 0],
          "alpha": 1
        }
      },
      "200": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.922, 0, 0],
          "alpha": 1
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.708, 0, 0],
          "alpha": 1
        }
      },
      "500": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0, 0],
          "alpha": 1
        },
        "$description": "Secondary text ink. shadcn ships 0.556, which measures 4.34:1 on `muted` (0.97) — below the AA floor A11Y-1 gates. 0.50 (COL-24, 2026-10-31; was 0.539) keeps secondary text at AA on every interaction state it sits on, not only on rest grounds: 5.05:1 on a selected row (`--state-selected`, 8% foreground), 4.83:1 on a pressed row (10%), 4.64:1 on a selected row over `muted`, 5.50:1 on `muted` and 6.00:1 on the page. The headroom over 4.5 is deliberate: axe measures the 8-bit sRGB round-trip, which reads ~0.04 lower than the OKLCH computation. This is the one core-neutral deviation from upstream."
      },
      "800": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.269, 0, 0],
          "alpha": 1
        }
      },
      "900": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.205, 0, 0],
          "alpha": 1
        }
      },
      "950": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.145, 0, 0],
          "alpha": 1
        }
      }
    },
    "white-alpha": {
      "10": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "alpha": 0.1
        }
      },
      "15": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "alpha": 0.15
        }
      }
    }
  }
}
