{
  "name": "@vegastack/design",
  "version": "0.1.0",
  "description": "VegaStack design system — cn utility, icon runtime, Tailwind v4 preset, and the vegastack-design CLI (tokens ship separately as @vegastack/design-tokens)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VegaStack/vegastack-design.git",
    "directory": "packages/design"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "bin",
    "css",
    "preset.css"
  ],
  "bin": {
    "vegastack-design": "./bin/vegastack-design.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./preset.css": "./preset.css",
    "./theme.css": "./css/theme.css",
    "./base.css": "./css/base.css",
    "./utilities.css": "./css/utilities.css"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && pnpm run verify",
    "verify": "node ../../tooling/verify-preset-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/compare.test.mjs && node test/check-updates.test.mjs"
  },
  "dependencies": {
    "@vegastack/design-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "tailwind-merge": "^3.6.0",
    "thesvg": "^3.2.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "tw-animate-css": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.1",
    "@tailwindcss/oxide": "4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vegastack/eslint-config": "workspace:*",
    "@vegastack/typescript-config": "workspace:*",
    "eslint": "^10.7.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
