{
  "extends": "@vegastack/typescript-config/react-library.json",
  // No `outDir`: tsup owns `dist` (see tsup.config.ts) and this config is
  // `noEmit`, so the option emitted nothing — it only made tsc infer a `rootDir`
  // of `packages/ui` and reject any file outside it. The browser suite is the
  // only runner in the repo that can exercise `apps/docs`'s gallery tile, so
  // `animated-icons.test.tsx` imports it across that boundary deliberately.
  "compilerOptions": {
    "paths": {
      "@/components/ui/*": ["./registry/ui/*"],
      "@/components/*": ["./registry/*"],
      "@/lib/*": ["./registry/lib/*"],
      "@/hooks/*": ["./registry/hooks/*"]
    }
  },
  "include": [
    "src",
    "registry",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest-axe.d.ts"
  ],
  // Vendored lucide-animated icon sources (mirrored upstream Motion components) import `motion/react`.
  // @vegastack/ui does NOT bundle them or depend on `motion` — the registry item declares `motion` as
  // the CONSUMER's dependency (installed on `shadcn add`). They're regenerated by the mirror and are
  // type-checked in apps/docs (where motion is present), so exclude them from this package's tsc scope.
  "exclude": ["registry/ui/icons"]
}
