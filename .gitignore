.dev.vars

# vitest browser-mode artifacts
.vitest-attachments/
**/__screenshots__/

# Screenshots are NEVER committed. `tooling/vrt-review.mjs` captures the base ref and the working
# tree on one machine minutes apart, so there is no reference set to store — and a committed one
# could not be regenerated by a team split across macOS, Windows, and a third CI machine.
apps/docs/vrt/*-snapshots/
.vrt-review/
.playwright-cli/

# Ad-hoc screenshots from manual `playwright` CLI runs. Scratch, referenced by nothing, and
# explicitly skipped by tooling/secret-scan.mjs — so it must never become commit-eligible.
output/

# Static-export Markdown manifest. Generated deterministically after each docs build.
apps/docs/.generated/

# Playwright JSON reporter output (release/deploy contract gates).
apps/docs/contracts-report.json
