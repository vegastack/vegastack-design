# Agent worktrees. Claude Code creates a git worktree per sub-agent here, each one a full checkout
# with its own .git file — so `git add -A` in the main checkout stages them as embedded
# repositories, and the warning it prints is easy to miss. This has never been ignored; it became
# dangerous when the audit epic left 22 of them holding unpushed commits.
.claude/worktrees/

# Vitest 5 run artifacts. Vitest 5 consolidated every artifact — attachments, failure screenshots,
# blob and HTML reports — under ONE `.vitest` directory at the project root, so this single entry
# covers what `.vitest-attachments/` used to as well. `tooling/workspace-clean.mjs --after-run`
# removes it after every `pnpm verify`, so it exists only mid-run — but a `git add -A` during a run
# would otherwise stage it.
packages/ui/.vitest/

# vitest browser-mode reference screenshots (`toMatchScreenshot`)
**/__screenshots__/

# Ad-hoc screenshots from manual `playwright` CLI runs. Scratch, referenced by nothing, and
# explicitly skipped by tooling/secret-scan.mjs — so it must never become commit-eligible.
output/

# Static-export Markdown manifest. Generated deterministically after each docs build.
apps/docs/.generated/

# Contract-derived BUILD OUTPUTS (WP4 / R4). Pure functions of
# packages/ui/component-contracts.json and the icon sources it names, written by
# `tooling/sync-component-derived.mjs --build-outputs` from `prepare:content` in both workspaces
# that read them. They were committed until 2026-09-08 and conflicted on every sibling merge.
# The authoritative list is tooling/lib/derived-build-outputs.mjs.
# NOT covered here, and still committed on purpose: the registry copy-in
# (apps/docs/components/ui/*) and apps/docs/public/r/* — locked distribution decision — and the
# derived PROSE surfaces (docs/ledger/component-matrix.md, the public skill roster, the audit
# register, AGENTS.md § Numbers), which are read straight out of git without a build.
apps/docs/lib/home-component-catalog.generated.ts
apps/docs/components/animated-icon-gallery.generated.tsx

# system audit 2026-09-07: screenshots and probe data are regenerated by the harness
docs/audits/2026-09-07-system-audit/captures/
