# Public npmjs registry for @vegastack/*.
@vegastack:registry=https://registry.npmjs.org/
# No auth line, on purpose. Publishing is CI-only from `release.yml` via npm OIDC trusted publishing
# (token-free, self-hosted, `npm publish --no-provenance`); no workflow injects a NODE_AUTH_TOKEN and
# tooling/verify-workflow-security.mjs rejects one. A manual local publish is not a sanctioned path —
# if one is ever needed, the credential belongs in ~/.npmrc, never in this committed file.
auto-install-peers=true
