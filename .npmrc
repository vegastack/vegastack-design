# Public npmjs registry for @vegastack/*.
@vegastack:registry=https://registry.npmjs.org/
# Publishing is token-free npm OIDC trusted publishing from release.yml — there is no NODE_AUTH_TOKEN
# anywhere, and tooling/verify-workflow-security.mjs forbids reintroducing one. For a manual local
# `pnpm publish`, set a token via `pnpm config set` or ~/.npmrc, never here.
auto-install-peers=true
# Fail fast when the toolchain is wrong instead of installing against an unsupported Node. The
# version itself lives in .node-version (and package.json `engines`), which the CI runners and the
# Playwright container both read.
engine-strict=true
