# Public npmjs registry for @vegastack/*.
@vegastack:registry=https://registry.npmjs.org/
# Publishing is token-free npm OIDC trusted publishing from release.yml — there is no NODE_AUTH_TOKEN
# anywhere, and tooling/verify-workflow-security.mjs forbids reintroducing one. For a manual local
# `pnpm publish`, set a token via `pnpm config set` or ~/.npmrc, never here.
auto-install-peers=true
# THE NODE VERSION IS PINNED AND MANAGED BY PNPM, and the setting is NOT here: it is
# `devEngines.runtime` in package.json (node 24.20.0, `onFail: download`). pnpm 10 moved every
# pnpm-specific setting out of .npmrc, and pnpm 11 supersedes the old `useNodeVersion` with
# devEngines — which resolves the runtime INTO pnpm-lock.yaml with a checksum, so the version is
# locked the same way a dependency is. pnpm downloads it once and runs every script and lifecycle
# hook with it, whatever Node is on PATH:
#
#   $ node -v            # v25.9.0   the host
#   $ pnpm exec node -v  # v24.20.0  every `pnpm run`, and therefore every gate
#
# `engine-strict` below checks `package.json` `engines` (`>=24.14.0 <26`) and is belt to that
# braces. On its own it never pinned anything — the range used to read `>=24.14.0`, so the
# development Mac ran the whole suite on Node 25.9 and installed cleanly while CI ran 24, which is
# exactly the drift the runbooks claimed it prevented. `.node-version` is advisory, for developers
# whose fnm/nvm/mise picks a shell Node before pnpm is ever invoked.
engine-strict=true
