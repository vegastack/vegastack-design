# Public npmjs registry for @vegastack/*.
@vegastack:registry=https://registry.npmjs.org/
# NOTE: CI/publish auth is injected by actions/setup-node (registry-url + NODE_AUTH_TOKEN),
# which writes its own .npmrc. pnpm intentionally refuses to expand ${NODE_AUTH_TOKEN} from a
# committed project .npmrc (security), so the local token line is omitted here to avoid noise.
# For a manual local `pnpm publish`, set the token via `pnpm config set` or ~/.npmrc.
auto-install-peers=true
