{
  "name": "@vegastack/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "node ../../tooling/sync-component-derived.mjs --build-outputs --only apps/docs && fumadocs-mdx",
    "build": "pnpm prepare:content && next build && tsx scripts/generate-markdown.ts && pnpm verify:metadata && pnpm verify:export && pnpm verify:emitted-css",
    "dev": "pnpm prepare:content && next dev",
    "start": "serve out",
    "lint": "pnpm prepare:content && eslint . && node scripts/deployment-boundaries.test.mjs && node ../../tooling/design-lint.mjs --token-css app && node ../../tooling/design-lint.mjs components/ui && node ../../tooling/design-lint.mjs components/preview && node ../../tooling/design-lint.mjs --docs-shell && node ../../tooling/content-lint.mjs && node ../../tooling/verify-provider-dogfood.mjs && tsx scripts/lint-links.ts && node ../../tooling/changelog-lint.mjs && node ../../tooling/sync-changelog.mjs --check && node ../../tooling/verify-docs-export.mjs --self-test && pnpm verify:mdx-manifest && node ../../tooling/design-lint-emitted-css.mjs --self-test && pnpm verify:base-mirror && node ../../tooling/verify-docs-base-mirror.mjs --self-test",
    "typecheck": "pnpm prepare:content && next typegen && tsc --noEmit",
    "registry:serve": "serve public/r -l 4000 --cors",
    "lint:links": "tsx scripts/lint-links.ts",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "verify:export": "node ../../tooling/verify-docs-export.mjs",
    "verify:mdx-manifest": "tsx scripts/verify-mdx-manifest.ts",
    "verify:emitted-css": "node ../../tooling/design-lint.mjs --docs-shell --emitted-css",
    "verify:base-mirror": "node ../../tooling/verify-docs-base-mirror.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.0",
    "@base-ui/react": "1.8.0",
    "@fumadocs/story": "^1.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vegastack/design": "workspace:*",
    "@vegastack/design-tokens": "workspace:*",
    "@vegastack/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-twoslash": "3.3.1",
    "fumadocs-typescript": "5.4.0",
    "fumadocs-ui": "16.15.8",
    "geist": "^1.6.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-dropzone": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "thesvg": "^3.3.2",
    "tw-animate-css": "^1.4.0",
    "twoslash": "^0.3.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vegastack/eslint-config": "workspace:*",
    "eslint": "^10.10.0",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "shadcn": "4.21.0",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "wrangler": "^4.129.0"
  }
}
