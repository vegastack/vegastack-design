{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "signup-04",
  "title": "Signup 04",
  "description": "A signup page with form and image.",
  "dependencies": [
    "thesvg@^3.3.3",
    "@vegastack/design@^0.6.1",
    "@vegastack/design-tokens@^0.5.0"
  ],
