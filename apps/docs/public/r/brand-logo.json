      "path": "packages/ui/registry/ui/brand-logo.tsx",
      "content": "// @vegastack brand-logo@0.60.3 sha256-VtLeLMw320MVq2b2UQgHQQGOHTDaDQHWPT8bNEP4w0k=\n\nimport * as React from \"react\";\nimport { cn } from \"@vegastack/design\";\nimport { BrandIcon, type BrandIconModule } from \"@vegastack/design/icons\";\n\n/* ------------------------------------------------------------------------------------------------\n * BrandLogo — a provider, tool or channel named by its mark: a small monochrome tile (the `muted`\n * fill, the `foreground` ink) holding one glyph, so a row of mixed brands reads as one set and\n * follows the theme. Never the brand's own colours: a logo in a settings list is an identifier,\n * not a promotion.\n *\n * The marks are Simple Icons path data (https://simpleicons.org, CC0 1.0), one 24×24 path each,\n * drawn through `BrandIcon`'s `mono` variant so they fill with `currentColor`. Simple Icons\n * records no licence of its own for any mark used here, so the project's CC0 dedication covers the\n * path data; the marks themselves remain their owners' trademarks and are used only to name them.\n * A brand Simple Icons does not carry — or carries under a licence other than CC0 — renders its\n * first letter in the same tile instead (the note under `MARKS` says which and why).\n * ----------------------------------------------------------------------------------------------*/\n\n/** Every brand `BrandLogo` can draw. */\nexport type Brand =\n  | \"anthropic\"\n  | \"openai\"\n  | \"google\"\n  | \"openrouter\"\n  | \"claude\"\n  | \"claude-code\"\n  | \"chatgpt\"\n  | \"codex\"\n  | \"cursor\"\n  | \"copilot\"\n  | \"gemini\"\n  | \"slack\"\n  | \"gmail\"\n  | \"mcp\";\n\n/** The brand's own name, as it is written. */\nconst BRAND_NAME: Record<Brand, string> = {\n  anthropic: \"Anthropic\",\n  openai: \"OpenAI\",\n  google: \"Google\",\n  openrouter: \"OpenRouter\",\n  claude: \"Claude\",\n  \"claude-code\": \"Claude Code\",\n  chatgpt: \"ChatGPT\",\n  codex: \"Codex\",\n  cursor: \"Cursor\",\n  copilot: \"Copilot\",\n  gemini: \"Gemini\",\n  slack: \"Slack\",\n  gmail: \"Gmail\",\n  mcp: \"MCP\",\n};\n\n/**\n * One Simple Icons glyph (24×24 viewBox) as a `BrandIcon` module. `mono` fills with\n * `currentColor`; no brand colour is carried.\n */\nfunction mark(slug: string, title: string, d: string): BrandIconModule {\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\" focusable=\"false\"><path d=\"${d}\"/></svg>`;\n  return { slug, title, hex: \"\", svg, variants: { mono: svg } };\n}\n\n/**\n * The marks Simple Icons carries under its CC0 dedication. Brands missing here draw\n * their first letter.\n */\nconst MARKS: Partial<Record<Brand, BrandIconModule>> = {\n  // simple-icons@16.37.0 · anthropic\n  anthropic: mark(\n    \"anthropic\",\n    \"Anthropic\",\n    \"M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z\",\n  ),\n  // simple-icons@16.37.0 · google\n  google: mark(\n    \"google\",\n    \"Google\",\n    \"M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z\",\n  ),\n  // simple-icons@16.37.0 · openrouter\n  openrouter: mark(\n    \"openrouter\",\n    \"OpenRouter\",\n    \"M16.778 1.844v1.919q-.569-.026-1.138-.032-.708-.008-1.415.037c-1.93.126-4.023.728-6.149 2.237-2.911 2.066-2.731 1.95-4.14 2.75-.396.223-1.342.574-2.185.798-.841.225-1.753.333-1.751.333v4.229s.768.108 1.61.333c.842.224 1.789.575 2.185.799 1.41.798 1.228.683 4.14 2.75 2.126 1.509 4.22 2.11 6.148 2.236.88.058 1.716.041 2.555.005v1.918l7.222-4.168-7.222-4.17v2.176c-.86.038-1.611.065-2.278.021-1.364-.09-2.417-.357-3.979-1.465-2.244-1.593-2.866-2.027-3.68-2.508.889-.518 1.449-.906 3.822-2.59 1.56-1.109 2.614-1.377 3.978-1.466.667-.044 1.418-.017 2.278.02v2.176L24 6.014Z\",\n  ),\n  // simple-icons@16.37.0 · claude\n  claude: mark(\n    \"claude\",\n    \"Claude\",\n    \"m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z\",\n  ),\n  // simple-icons@16.37.0 · claudecode\n  \"claude-code\": mark(\n    \"claudecode\",\n    \"Claude Code\",\n    \"M21 10.5h3v3h-3v3h-1.5v3H18v-3h-1.5v3H15v-3H9v3H7.5v-3H6v3H4.5v-3H3v-3H0v-3h3v-6h18Zm-15 0h1.5v-3H6Zm10.5 0H18v-3h-1.5z\",\n  ),\n  // simple-icons@16.37.0 · cursor\n  cursor: mark(\n    \"cursor\",\n    \"Cursor\",\n    \"M11.503.131 1.891 5.678a.84.84 0 0 0-.42.726v11.188c0 .3.162.575.42.724l9.609 5.55a1 1 0 0 0 .998 0l9.61-5.55a.84.84 0 0 0 .42-.724V6.404a.84.84 0 0 0-.42-.726L12.497.131a1.01 1.01 0 0 0-.996 0M2.657 6.338h18.55c.263 0 .43.287.297.515L12.23 22.918c-.062.107-.229.064-.229-.06V12.335a.59.59 0 0 0-.295-.51l-9.11-5.257c-.109-.063-.064-.23.061-.23\",\n  ),\n  // simple-icons@16.37.0 · googlegemini\n  gemini: mark(\n    \"googlegemini\",\n    \"Gemini\",\n    \"M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81\",\n  ),\n  // simple-icons@16.37.0 · gmail\n  gmail: mark(\n    \"gmail\",\n    \"Gmail\",\n    \"M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z\",\n  ),\n  // simple-icons@16.37.0 · modelcontextprotocol\n  mcp: mark(\n    \"modelcontextprotocol\",\n    \"MCP\",\n    \"M13.85 0a4.16 4.16 0 0 0-2.95 1.217L1.456 10.66a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l9.442-9.442a2.49 2.49 0 0 1 3.541 0 2.49 2.49 0 0 1 0 3.541L8.59 12.97l-.1.1a.835.835 0 0 0 0 1.18.835.835 0 0 0 1.18 0l.1-.098 7.03-7.034a2.49 2.49 0 0 1 3.542 0l.049.05a2.49 2.49 0 0 1 0 3.54l-8.54 8.54a1.96 1.96 0 0 0 0 2.755l1.753 1.753a.835.835 0 0 0 1.18 0 .835.835 0 0 0 0-1.18l-1.753-1.753a.266.266 0 0 1 0-.394l8.54-8.54a4.185 4.185 0 0 0 0-5.9l-.05-.05a4.16 4.16 0 0 0-2.95-1.218c-.2 0-.401.02-.6.048a4.17 4.17 0 0 0-1.17-3.552A4.16 4.16 0 0 0 13.85 0m0 3.333a.84.84 0 0 0-.59.245L6.275 10.56a4.186 4.186 0 0 0 0 5.902 4.186 4.186 0 0 0 5.902 0L19.16 9.48a.835.835 0 0 0 0-1.18.835.835 0 0 0-1.18 0l-6.985 6.984a2.49 2.49 0 0 1-3.54 0 2.49 2.49 0 0 1 0-3.54l6.983-6.985a.835.835 0 0 0 0-1.18.84.84 0 0 0-.59-.245\",\n  ),\n};\n\n/*\n * Brands drawn as their first letter (no entry in MARKS), checked against simple-icons@16.37.0:\n * - `openai`, `chatgpt`, `codex`, `slack`: Simple Icons does not carry them.\n * - `copilot`: Simple Icons' `githubcopilot` is licensed MIT, not CC0, so it is not copied here.\n */\n\n/** Props accepted by `BrandLogo`. */\nexport interface BrandLogoProps extends Omit<\n  React.ComponentPropsWithRef<\"span\">,\n  \"children\"\n> {\n  /** Which brand to draw. */\n  brand: Brand;\n  /**\n   * The tile's size: `default` is 20px (`size-5`), `sm` is 16px (`size-4`) for a dense row.\n   * @default \"default\"\n   */\n  size?: \"sm\" | \"default\";\n  /**\n   * The accessible name — usually the brand's name (\"Anthropic\"). Omit it when the brand is\n   * already named in text beside the tile: the tile is then decorative (`aria-hidden`).\n   * @default undefined\n   */\n  label?: string;\n}\n\n/**\n * `BrandLogo` — a brand's mark in a small monochrome tile, for naming a provider, a tool or a\n * channel in a list or a picker. Server-safe.\n *\n * @example\n * <BrandLogo brand=\"anthropic\" />                      // decorative, beside \"Anthropic\"\n * <BrandLogo brand=\"slack\" size=\"sm\" label=\"Slack\" />  // stands alone, so it is named\n */\nexport function BrandLogo({\n  brand,\n  size = \"default\",\n  label,\n  className,\n  ...props\n}: BrandLogoProps): React.ReactElement {\n  const glyph = MARKS[brand];\n  return (\n    <span\n      data-slot=\"brand-logo\"\n      data-brand={brand}\n      data-size={size}\n      data-mark={glyph ? \"glyph\" : \"letter\"}\n      role={label ? \"img\" : undefined}\n      aria-label={label || undefined}\n      aria-hidden={label ? undefined : true}\n      className={cn(\n        \"inline-flex shrink-0 items-center justify-center rounded-sm bg-muted text-foreground\",\n        size === \"sm\" ? \"size-4\" : \"size-5\",\n        className,\n      )}\n      {...props}\n    >\n      {glyph ? (\n        <BrandIcon\n          icon={glyph}\n          variant=\"mono\"\n          aria-label=\"\"\n          size=\"xs\"\n          className={size === \"sm\" ? \"size-3\" : undefined}\n        />\n      ) : (\n        <span\n          aria-hidden\n          className=\"text-xs leading-none font-semibold select-none\"\n        >\n          {BRAND_NAME[brand].charAt(0)}\n        </span>\n      )}\n    </span>\n  );\n}\n",
      "type": "registry:ui",
      "target": "@ui/brand-logo.tsx"
    }
  ],
  "meta": {
    "whenToUse": "Naming a model provider, coding tool or channel by its mark in a list, a picker or a settings row (Anthropic, OpenAI, Slack, MCP) — beside its name, or labelled when it stands alone.",
    "whenNotToUse": "A brand in its own colours or a wordmark (BrandIcon with a thesvg module); a person or workspace (Avatar); a functional icon (lucide).",
