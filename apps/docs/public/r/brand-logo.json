{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "brand-logo",
  "title": "Brand Logo",
  "description": "A provider, tool or channel's mark in a small monochrome tile — Simple Icons (CC0) glyphs in the theme's ink, or the brand's first letter where no CC0 mark exists. Server-safe.",
  "dependencies": [
    "@vegastack/design@^0.13.0",
    "@vegastack/design-tokens@^0.11.0"
  ],
  "registryDependencies": [],
