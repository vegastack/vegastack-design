  "files": [
    {
      "path": "packages/ui/registry/blocks/login-02/components/login-form.tsx",
      "content": "// @vegastack login-02@0.12.2 sha256-D2PnTTqT+DdLWNrWg4CVQyAFy/9i4YlwnFM1mDrfu9c=\n\nimport { cn } from \"@vegastack/design\";\n\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldSeparator,\n} from \"@/components/ui/field\";\nimport { Input } from \"@/components/ui/input\";\nimport { BrandIcon } from \"@vegastack/design/icons\";\nimport github from \"thesvg/github\";\n\nexport function LoginForm({\n  className,\n  ...props\n}: React.ComponentProps<\"form\">) {\n  return (\n    <form className={cn(\"flex flex-col gap-6\", className)} {...props}>\n      <FieldGroup>\n        <div className=\"flex flex-col items-center gap-1 text-center\">\n          <h1 className=\"text-2xl font-semibold\">Login to your account</h1>\n          <p className=\"text-sm text-balance text-muted-foreground\">\n            Enter your email below to login to your account\n          </p>\n        </div>\n        <Field>\n          <FieldLabel htmlFor=\"email\">Email</FieldLabel>\n          <Input id=\"email\" type=\"email\" placeholder=\"m@example.com\" required />\n        </Field>\n        <Field>\n          <div className=\"flex items-center\">\n            <FieldLabel htmlFor=\"password\">Password</FieldLabel>\n            <a\n              href=\"#\"\n              className=\"ms-auto text-sm underline-offset-4 hover:underline relative after:absolute after:inset-x-0 after:-inset-y-1 after:content-['']\"\n            >\n              Forgot your password?\n            </a>\n          </div>\n          <Input id=\"password\" type=\"password\" required />\n        </Field>\n        <Field>\n          <Button type=\"submit\">Login</Button>\n        </Field>\n        <FieldSeparator>Or continue with</FieldSeparator>\n        <Field>\n          <Button variant=\"outline\" type=\"button\">\n            <BrandIcon icon={github} variant=\"mono\" size=\"sm\" aria-label=\"\" />\n            Login with GitHub\n          </Button>\n          <FieldDescription className=\"text-center\">\n            Don&apos;t have an account?{\" \"}\n            <a href=\"#\" className=\"underline underline-offset-4\">\n              Sign up\n            </a>\n          </FieldDescription>\n        </Field>\n      </FieldGroup>\n    </form>\n  );\n}\n",
      "type": "registry:component",
      "target": "app/login-02/components/login-form.tsx"
    },
    {
      "path": "packages/ui/registry/blocks/login-02/page.tsx",
      "content": "// @vegastack login-02@0.12.2 sha256-D2PnTTqT+DdLWNrWg4CVQyAFy/9i4YlwnFM1mDrfu9c=\n\nimport { LoginForm } from \"./components/login-form\";\nimport { GalleryVerticalEndIcon } from \"lucide-react\";\n\nexport default function LoginPage() {\n  return (\n    <div className=\"grid min-h-svh lg:grid-cols-2\">\n      <div className=\"flex flex-col gap-4 p-6 md:p-10\">\n        <div className=\"flex justify-center gap-2 md:justify-start\">\n          <a href=\"#\" className=\"flex items-center gap-2 font-medium\">\n            <div className=\"flex size-6 items-center justify-center rounded-md bg-primary text-primary-foreground\">\n              <GalleryVerticalEndIcon className=\"size-4\" />\n            </div>\n            Acme Inc.\n          </a>\n        </div>\n        <div className=\"flex flex-1 items-center justify-center\">\n          <div className=\"w-full max-w-xs\">\n            <LoginForm />\n          </div>\n        </div>\n      </div>\n      <div className=\"relative hidden bg-muted lg:block\">\n        <img\n          src=\"/placeholder.svg\"\n          alt=\"Image\"\n          className=\"absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale\"\n        />\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:page",
      "target": "app/login-02/page.tsx"
    }
  ],
  "meta": {
    "whenToUse": "Starting from upstream's Login 02 composition — copy it once and own it.",
