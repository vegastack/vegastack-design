{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
  "globalEnv": ["SITE_VISIBILITY"],
  "globalDependencies": ["tooling/**"],
  "tasks": {
    // Contract-derived BUILD OUTPUTS (WP4 / R4): generated by `sync-component-derived.mjs
    // --build-outputs` per workspace, gitignored, cached by turbo. Each package declares only the
    // outputs it writes — a task cannot capture files outside its own directory.
    "prepare:content": {
      "inputs": [
        "$TURBO_ROOT$/packages/ui/component-contracts.json",
        "$TURBO_ROOT$/packages/ui/registry/ui/icons/**",
        "content/**",
        "source.config.ts"
      ]
    },
    "@vegastack/docs#prepare:content": {
      "inputs": [
        "$TURBO_ROOT$/packages/ui/component-contracts.json",
        "$TURBO_ROOT$/packages/ui/registry/ui/icons/**",
        "content/**",
        "source.config.ts"
      ],
      "outputs": [
        "lib/home-component-catalog.generated.ts",
        "components/animated-icon-gallery.generated.tsx",
        ".source/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "prepare:content"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "prepare:content"]
    },
    // `@vegastack/design-tokens#lint` reads its OWN build output: `verify-theme-parity.mjs` and
    // `contrast-check.mjs` both take `dist/theme.css`. The generic `lint` above depends on `^build`
    // — UPSTREAM packages — and design-tokens has no upstream, so nothing built it. `pnpm lint` in a
    // clean checkout therefore failed with `ENOENT … dist/theme.css`, and only passed today because
    // the root `lint` script happens to run `design:verify` (which builds tokens) first. A task must
    // declare the inputs it reads; ordering by luck is not a dependency.
    "@vegastack/design-tokens#lint": {
      "dependsOn": ["^build", "build", "prepare:content"]
    },
    "test": {
      "dependsOn": ["^build", "prepare:content"],
      "outputs": ["coverage/**"]
    },
    // `@vegastack/ui#test` READS FILES OUTSIDE ITS OWN PACKAGE, and turbo's default input set is
    // package-local. `test/geometry.browser.test.tsx` imports `@/components/preview` — aliased in
    // `packages/ui/vitest.config.ts` to `apps/docs/components/preview` — and mounts every fixture it
    // exports; `test/geometry.css` additionally `@source`s that directory and `preview-controls.tsx`
    // so their wrapper utilities compile. With only the package defaults hashed, editing a preview
    // fixture left the hash unchanged and turbo REPLAYED a green run over source it had never
    // executed — a cache hit that is indistinguishable from verification.
    //
    // `$TURBO_DEFAULT$` keeps the package-local defaults (respecting .gitignore); the two
    // `$TURBO_ROOT$` globs add exactly what the alias and the `@source` globs reach. Every other
    // `@/…` specifier in those fixtures resolves back into `packages/ui/registry` (see the alias
    // table), so nothing else in `apps/docs` is an input.
    "@vegastack/ui#test": {
      "dependsOn": ["^build", "prepare:content"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/components/preview/**",
        "$TURBO_ROOT$/apps/docs/components/preview-controls.tsx"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "prepare:content"]
    }
  },
  "remoteCache": {
    "signature": true
  }
}
